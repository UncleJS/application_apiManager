# Dev container for API Manager
# Base: official Bun image with Node/npm already available
FROM oven/bun:1.2.15

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      git \
      openssl \
      ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Bake source into the image at build time
COPY . /workspace

# Install backend deps
RUN cd /workspace/backend && bun install

# Install frontend deps
RUN cd /workspace/frontend && bun install

# Default: keep alive so podman exec can run arbitrary commands
CMD ["sleep", "infinity"]
