MARIADB_ROOT_PASSWORD=change_me
MARIADB_DATABASE=api_manager
MARIADB_USER=api_manager
MARIADB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me
DB_WAIT_RETRIES=60
DB_WAIT_DELAY_MS=2000
SESSION_IDLE_SECONDS=3600
SESSION_HARD_MAX_SECONDS=10800
# default admin user: global-admin
BOOTSTRAP_ADMIN_PASSWORD=change_this_to_a_unique_strong_password
SEED_USER_PASSWORD=change_this_for_seeded_users
SEED_DATA=false
SEED_ACCESS_LOGS=false
NEXT_PUBLIC_API_URL=https://localhost:1101
CORS_ORIGIN=https://localhost:1100
PROXY_MAX_REQUEST_BYTES=10485760
PROXY_MAX_RESPONSE_BYTES=10485760
PROXY_TIMEOUT_MS=30000
# Swagger and /openapi.json stay off unless this is true.
DOCS_ENABLED=false
# phpMyAdmin is not published unless this is true. install.sh --enable-phpmyadmin also turns it on.
ENABLE_PHPMYADMIN=false
