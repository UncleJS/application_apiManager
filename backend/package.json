{
  "name": "api-manager-backend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "echo 'No build step — Bun runs TypeScript directly'",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "BOOTSTRAP_ADMIN=false bun test",
    "test:watch": "BOOTSTRAP_ADMIN=false bun test --watch",
    "seed": "bun run src/scripts/seed.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.1.1",
    "@elysiajs/swagger": "^1.1.3",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.38.3",
    "elysia": "^1.1.27",
    "luxon": "^3.5.0",
    "mysql2": "^3.11.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/bun": "^1.1.14",
    "@types/luxon": "^3.4.2",
    "@types/node": "^20.17.24",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "drizzle-kit": "^0.29.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "typescript": "^5.7.2"
  }
}
