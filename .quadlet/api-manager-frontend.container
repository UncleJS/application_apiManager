[Unit]
Description=API Manager - Frontend (Next.js)
After=api-manager-backend.service
Requires=api-manager-backend.service

[Container]
Image=localhost/api-manager-frontend:latest
ContainerName=api-manager-frontend
Pod=api-manager-pod.pod
EnvironmentFile=__REPO_ENV__
HealthCmd=sh -lc 'IP=$(hostname -i | awk "{print \$1}"); wget -q -O - "http://$IP:3000" >/dev/null'
HealthInterval=10s
HealthTimeout=5s
HealthRetries=6

[Service]
Restart=always
TimeoutStartSec=120
TimeoutStopSec=30

[Install]
WantedBy=default.target
