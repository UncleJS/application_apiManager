[Unit]
Description=API Manager - Backend (Elysia/Bun)
After=api-manager-mariadb.service
Requires=api-manager-mariadb.service

[Container]
Image=localhost/api-manager-backend:latest
ContainerName=api-manager-backend
Pod=api-manager-pod.pod
EnvironmentFile=%h/.config/containers/systemd/api-manager.env
Environment=PORT=3001
Environment=HOST=0.0.0.0
Environment=DB_HOST=127.0.0.1
Environment=DB_PORT=3306
HealthCmd=sh -lc 'IP=$(hostname -i | awk "{print \$1}"); wget -q -O - "http://$IP:3001/healthz" >/dev/null'
HealthInterval=10s
HealthTimeout=5s
HealthRetries=6

[Service]
Restart=always
TimeoutStartSec=120
TimeoutStopSec=30

[Install]
WantedBy=default.target
